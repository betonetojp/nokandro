<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/timelineRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp"
    android:background="@drawable/widget_live_note_background">

    <!-- Top Bar: App branding + TTS/Timer toggles + Post button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <ImageView
            android:id="@+id/timelineAppIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/timelineAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="nokandro"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/on_surface_variant" />

        <TextView
            android:id="@+id/timelineTtsBtn"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:gravity="center"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:layout_marginStart="6dp"
            android:text="TTS"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/primary"
            android:background="@drawable/bg_status_chip" />

        <TextView
            android:id="@+id/timelineTimerBtn"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:gravity="center"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:layout_marginStart="4dp"
            android:text="Timer"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/on_surface_variant"
            android:background="@drawable/bg_status_chip" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/timelineQuickPostBtn"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:gravity="center"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="Post"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/primary"
            android:background="@drawable/bg_status_chip" />
    </LinearLayout>

    <!-- Scrollable Timeline Body -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/timelineListView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@drawable/timeline_widget_divider"
            android:dividerHeight="1dp"
            android:scrollbars="none"
            android:cacheColorHint="@android:color/transparent"
            android:listSelector="@android:color/transparent" />

        <TextView
            android:id="@+id/timelineEmptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="12dp"
            android:text="Listening for posts on Nostr..."
            android:textSize="12sp"
            android:textColor="@color/on_surface_variant" />
    </FrameLayout>

</LinearLayout>
